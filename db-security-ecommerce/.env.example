# ---------------------------------------------------------------
# Copy this file to ".env" and replace EVERY value with your own.
# .env is listed in .gitignore, so your real passwords are never committed.
# All passwords must be strong: 12+ chars, upper, lower, digit, symbol.
# Do not use the characters  "  '  $  in values (they break sqlcmd quoting).
# ---------------------------------------------------------------

# --- SQL Server connection (used by the Flask app) ---
DB_SERVER=localhost
DB_NAME=ShopDB
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Only needed for Docker: the "sa" password for the container
SA_PASSWORD=Change-Me-Sa#2026

# --- Logins created by 03_rbac.sql ---
# Least-privilege login used by the HARDENED app path (customer_role)
APP_PASSWORD=Change-Me-App#2026
# Over-privileged "legacy" login used ONLY by the deliberately VULNERABLE demo path
LEGACY_APP_PASSWORD=Change-Me-Legacy#2026
# Shared password for the 5 demo staff logins (shop_admin, sales_addis, ...)
STAFF_PASSWORD=Change-Me-Staff#2026

# --- Application (website) users seeded by 01_schema.sql ---
# Every sample website account (abebe.k, admin.tsehay, ...) gets this password
DEMO_USER_PASSWORD=Change-Me-User#2026

# --- Encryption (06_tde.sql) ---
MASTER_KEY_PASSWORD=Change-Me-MasterKey#2026
CERT_BACKUP_PASSWORD=Change-Me-CertBackup#2026

# --- Flask app ---
FLASK_SECRET_KEY=replace-with-a-long-random-string
# Fernet key that encrypts MFA (TOTP) secrets before they are stored in the DB.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace-with-generated-fernet-key
# 1 = show the deliberately vulnerable login/search (localhost lab demo ONLY)
ENABLE_VULNERABLE_DEMO=1
